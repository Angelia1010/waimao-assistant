# ============ 复制为 .env 后填写 ============

# ---- 运行模式 ----
# sqlite（推荐）：自带数据库 + 网页系统，打开 http://服务器IP:8080/app 登录使用，飞书只用来推送提醒（可选）
# feishu：旧版，用飞书多维表格当数据库和操作界面，需要填写下面整段飞书应用配置
STORAGE=sqlite
# 第一次启动时自动创建的管理员账号。不填密码会随机生成一个，打印在启动日志里
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 用 HTTPS 访问时改成 true
COOKIE_SECURE=false

# ---- 飞书自建应用（只有 STORAGE=feishu 才需要）----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 多维表格链接 https://xxx.feishu.cn/base/【这一段就是 APP_TOKEN】?table=...
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# 多维表格完整链接，用于推送卡片里的“打开客户表”按钮
BITABLE_URL=https://xxx.feishu.cn/base/xxxxxxxx
# 飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 webhook 地址（两种模式都可用；sqlite 模式也可以在网页「设置」里填）
FEISHU_BOT_WEBHOOK=
# 如果机器人开启了“签名校验”，填这里；没开就留空
FEISHU_BOT_SECRET=

# ---- 大模型（任意 OpenAI 兼容接口）----
# DeepSeek（推荐）: LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-v4-flash
#   （deepseek-chat 已于 2026-07-24 弃用，不要再用）
# 通义千问: LLM_BASE_URL 从阿里云百炼控制台复制（各地域地址不同），LLM_MODEL=qwen-plus
# 不填 LLM_API_KEY 会自动使用规则版 mock（只适合演示）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# ---- 业务邮箱 IMAP（可选；不填就只用粘贴页面录入）----
# 网易企业邮: imaphz.qiye.163.com   腾讯企业邮: imap.exmail.qq.com   阿里企业邮: imap.qiye.aliyun.com   Gmail: imap.gmail.com
# 密码一般要用“客户端专用密码/授权码”，不是登录密码
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=3

# ---- 运行参数 ----
SERVER_PORT=8080
# 随便填一串长的随机字符，粘贴页面和接口都要用它
API_TOKEN=change-me
POLL_SECONDS=30
MAIL_POLL_SECONDS=120
# 每天几点推送跟进提醒（24小时制，北京时间）
FOLLOWUP_TIME=09:00
TZ_OFFSET_HOURS=8
DATA_DIR=./data
# 首页产品展示页底部按钮的文字，例如“私信预约演示”
LANDING_CONTACT=预约演示

# ---- 公司信息（打印在报价单上，用英文）----
COMPANY_NAME_EN=Demo Hardware Co., Ltd.
COMPANY_NAME_CN=
COMPANY_ADDRESS=No. 88 Demo Road, Yinzhou, Ningbo, Zhejiang, China
COMPANY_CONTACT=Lily Chen | Sales Manager
COMPANY_EMAIL=sales@demo-hardware.com
COMPANY_PHONE=+86 574 0000 0000
COMPANY_WEBSITE=www.demo-hardware.com
# 可选：logo 图片路径（PNG/JPG）
COMPANY_LOGO_PATH=
QUOTE_CURRENCY=USD
QUOTE_INCOTERM=FOB Ningbo
QUOTE_PAYMENT_TERMS=T/T 30% deposit, 70% balance before shipment
QUOTE_VALIDITY_DAYS=30
QUOTE_BANK_INFO=
